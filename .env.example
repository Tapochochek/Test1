# Создайте бота через @BotFather и вставьте полученный токен.
TELEGRAM_BOT_TOKEN=

# Необязательно: ID группового чата/канала для общих уведомлений.
# Чтобы узнать ID группы, добавьте бота в неё и отправьте /chatid.
TELEGRAM_DEFAULT_CHAT_ID=

# Почта для кодов подтверждения при регистрации (необязательно).
# Без SMTP_HOST код печатается в логах api: docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
